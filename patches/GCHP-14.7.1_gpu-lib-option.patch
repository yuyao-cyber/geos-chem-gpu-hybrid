diff --git a/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt b/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt
index 709e417..9079c88 100755
--- a/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt
+++ b/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt
@@ -49,6 +49,18 @@ if(${KPPSA})
   set(MPI_LOAD_BALANCE OFF)
 endif()
 
+# Optional GPU chemistry library (nvfortran/OpenACC batched KPP solver).
+# Configure with -DGC_GPU_LIB=/path/to/libgcchemgpu.so to enable the
+# GC_BATCH_CHEM=2/3 runtime paths (CPP: GC_GPU_CHEM).  Empty = stock build.
+set(GC_GPU_LIB "" CACHE FILEPATH
+    "Path to libgcchemgpu.so (nvfortran/OpenACC batched chemistry solver); empty = no GPU path")
+if(GC_GPU_LIB)
+  get_filename_component(GC_GPU_LIB_DIR "${GC_GPU_LIB}" DIRECTORY)
+  # keep the library dirs in the installed gchp's RPATH (set before the targets are defined)
+  set(CMAKE_INSTALL_RPATH "${GC_GPU_LIB_DIR};${GC_GPU_LIB_DIR}/nvrt")
+  message(STATUS "GPU chemistry library: ${GC_GPU_LIB} (GC_GPU_CHEM defined)")
+endif()
+
 # Add directories to build
 add_subdirectory(Cloud-J EXCLUDE_FROM_ALL)
 add_subdirectory(HETP EXCLUDE_FROM_ALL)
@@ -72,6 +84,15 @@ target_compile_definitions(GEOSChemBuildProperties INTERFACE
   $<$<BOOL:${MPI_LOAD_BALANCE}>:MPI_LOAD_BALANCE>
 )
 
+if(GC_GPU_LIB)
+  target_compile_definitions(GEOSChemBuildProperties INTERFACE GC_GPU_CHEM)
+  target_link_libraries(GEOSChemBuildProperties INTERFACE
+      "${GC_GPU_LIB}"
+      "-Wl,-rpath,${GC_GPU_LIB_DIR}"
+      "-Wl,-rpath,${GC_GPU_LIB_DIR}/nvrt"
+      "-Wl,--export-dynamic-symbol=acc_register_library"
+  )
+endif()
 target_link_libraries(GEOSChemBuildProperties INTERFACE
     $<LINK_ONLY:MAPL.base>
     $<LINK_ONLY:FVdycoreCubed_GridComp>
